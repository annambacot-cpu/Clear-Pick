# Server-side only. Never prefix this key with NEXT_PUBLIC_.
SPORTS_DATA_PROVIDER=mock
THE_ODDS_API_KEY=

# Public URL only; this contains no secret. Leave blank for a same-origin Worker.
NEXT_PUBLIC_SPORTS_API_BASE_URL=
PUBLIC_APP_ORIGINS=https://annambacot-cpu.github.io

# Cache windows balance freshness with provider usage costs.
SPORTS_SCHEDULE_CACHE_SECONDS=600
SPORTS_LIVE_CACHE_SECONDS=40
SPORTS_MARKETS_CACHE_SECONDS=60
